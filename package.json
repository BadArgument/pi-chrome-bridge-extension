    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
